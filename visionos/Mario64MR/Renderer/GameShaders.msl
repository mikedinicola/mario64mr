// The game's draw calls in Metal: sm64ex's OpenGL shaders (src/pc/gfx/gfx_opengl.c), one pipeline per combiner.
// The batch's shader id is a function constant, so each pipeline is this source specialised to one combiner, as the
// GLSL that sm64ex generates per shader id is.
#include <metal_stdlib>
using namespace metal;

constant uint shaderId [[function_constant(0)]];
constant bool opaque [[function_constant(1)]];  // (in the room: not blended, so covering the passthrough)
constant bool depthOnly [[function_constant(2)]];  // (a diorama's see-through surfaces, again into depth: GameRenderer.encodeDiorama)

// gfx_cc.h: four 3-bit items per formula (colour, then alpha), then the options
constant bool optAlpha = (shaderId & (1u << 24)) != 0;
constant bool optFog = (shaderId & (1u << 25)) != 0;
constant bool optTextureEdge = (shaderId & (1u << 26)) != 0;
constant bool optNoise = (shaderId & (1u << 27)) != 0;

enum : uint { ZERO = 0, INPUT_1 = 1, INPUT_4 = 4, TEXEL0 = 5, TEXEL0A = 6, TEXEL1 = 7 };

static uint item(uint formula, uint index) { return (shaderId >> (formula * 12 + index * 3)) & 7; }

static uint inputCount() {
    uint count = 0;
    for (uint f = 0; f < 2; f++)
        for (uint i = 0; i < 4; i++) {
            uint c = item(f, i);
            if (c >= INPUT_1 && c <= INPUT_4) count = max(count, c);
        }
    return count;
}

static bool usesTexture(uint texture) {
    for (uint f = 0; f < 2; f++)
        for (uint i = 0; i < 4; i++) {
            uint c = item(f, i);
            if (texture == 0 ? (c == TEXEL0 || c == TEXEL0A) : c == TEXEL1) return true;
        }
    return false;
}

struct Varyings {
    float4 position [[position]];
    float2 uv;
    float4 fog;
    float4 input1, input2, input3, input4;
    float3 room;  // (in the room only) where it is in the room, in metres
};

// The vertex as gfx_pc.c writes it: position (the game's clip space, OpenGL depth), uv, fog, then the combiner's
// inputs. Returns the vertex with everything but its position; `clip` is the game's position.
static Varyings readVertex(uint vid, const device float *floats, thread float4 &clip) {
    const bool textured = usesTexture(0) || usesTexture(1);
    const uint inputs = inputCount(), inputSize = optAlpha ? 4 : 3;
    const uint stride = 4 + (textured ? 2 : 0) + (optFog ? 4 : 0) + inputs * inputSize;
    const device float *v = floats + vid * stride;

    Varyings out;
    clip = float4(v[0], v[1], v[2], v[3]);
    out.position = 0;
    out.room = 0;
    uint k = 4;
    out.uv = 0;
    if (textured) { out.uv = float2(v[k], v[k + 1]); k += 2; }
    out.fog = 0;
    if (optFog) { out.fog = float4(v[k], v[k + 1], v[k + 2], v[k + 3]); k += 4; }
    float4 in[4] = { 0, 0, 0, 0 };
    for (uint i = 0; i < inputs; i++) {
        in[i] = float4(v[k], v[k + 1], v[k + 2], optAlpha ? v[k + 3] : 1.0);
        k += inputSize;
    }
    out.input1 = in[0]; out.input2 = in[1]; out.input3 = in[2]; out.input4 = in[3];
    return out;
}

// In a flat view: the game's picture as it drew it
vertex Varyings game_vertex(uint vid [[vertex_id]], const device float *floats [[buffer(0)]]) {
    float4 clip;
    Varyings out = readVertex(vid, floats, clip);
    out.position = float4(clip.xy, (clip.z + clip.w) * 0.5, clip.w);  // (OpenGL's -w..w depth to Metal's 0..w)
    return out;
}

// ---------------------------------------------------------------- In the room (ImmersiveRenderer)
// The game camera's view space is placed in the room behind a window: the level is unprojected from the game's
// clip space into that view space, and drawn from each eye. The sky goes on a dome round the camera; the HUD and
// the game's other flat pictures on the window itself.

struct RoomDraw {
    float4x4 roomFromClip;  // the draw's projection undone, then the game camera's view space into the room
    uint4 kind;             // x: GameFrame.Kind, 3: Mario out in the room (roomFromClip through the room),
                            // 4: the level as a diorama on a table (y: the table's height, a float, below it cut away)
};

struct RoomEye {
    float4x4 viewProjection;  // the room to this eye's clip space
    float4x4 roomFromView;    // the game camera's view space (game units) into the room (metres)
    float4x4 roomFromWindow;  // the window's own space (metres; x right, y up, z towards the room) into the room
    float4x4 windowFromRoom;
    float4 eye;               // xyz: the eye in the window's space
    float4 window;            // xy: the opening's half size (metres), z: the sky's distance (game units),
                              // w: how far in from the opening's edge it fades out to the room (metres)
    float4 up;                // xyz: the game's up in the game camera's view space
};

// The sky's tiles as skybox.c lays them out (SCREEN_WIDTH 320 wide, 1280 units round, 4 units a degree up and
// down), turned into a direction from the camera: the picture's centre is where the camera looks
static float3 skyDirection(float2 ndc, float3 up) {
    float yaw = ndc.x * 160.0 * (M_PI_F / 2) / 320.0;  // (x half width: 160 units of the panorama)
    float pitch = ndc.y * 120.0 / 4.0 * (M_PI_F / 180);
    float3 forward = float3(0, 0, -1);
    float3 level = normalize(forward - dot(forward, up) * up);
    float3 right = cross(level, up);
    float3 turned = cos(yaw) * level + sin(yaw) * right;
    float p = asin(clamp(dot(forward, up), -1.0, 1.0)) + pitch;
    p = clamp(p, -M_PI_F / 2, M_PI_F / 2);  // (the extra rows past straight up or down stay at the pole, not folded over)
    return cos(p) * turned + sin(p) * up;
}

vertex Varyings game_vertex_room(uint vid [[vertex_id]], const device float *floats [[buffer(0)]],
                                 constant RoomDraw &draw [[buffer(1)]], constant RoomEye &eye [[buffer(2)]]) {
    float4 clip;
    Varyings out = readVertex(vid, floats, clip);
    float4 room;
    if (draw.kind.x == 0 || draw.kind.x >= 3) {  // the level, Mario in the room, the diorama: unprojected into the room
        room = draw.roomFromClip * clip;
    } else if (draw.kind.x == 1) {  // the sky: far away, round the camera
        float3 direction = skyDirection(clip.xy / clip.w, normalize(eye.up.xyz));
        room = eye.roomFromView * float4(direction * eye.window.z, 1);
    } else {                        // flat pictures: on the window
        float2 ndc = clip.xy / clip.w;
        room = eye.roomFromWindow * float4(ndc * eye.window.xy, 0.002, 1);
    }
    room /= room.w;
    out.room = room.xyz;
    out.position = eye.viewProjection * float4(room.xyz, 1);
    // The sky's depth: just short of infinitely far (about 100 km, reversed depth), so the level is always in front of
    // it but it isn't the clear's 0, which the headset's compositor shows the room through
    if (draw.kind.x == 1) out.position.z = out.position.w * 1e-6;
    return out;
}

struct Sources { float4 texel0, texel1, input[4]; };

static float3 colorOf(uint c, thread const Sources &s) {
    switch (c) {
        case TEXEL0: return s.texel0.rgb;
        case TEXEL0A: return float3(s.texel0.a);
        case TEXEL1: return s.texel1.rgb;
        case ZERO: return 0;
        default: return s.input[c - INPUT_1].rgb;
    }
}

static float alphaOf(uint c, thread const Sources &s) {
    switch (c) {
        case TEXEL0: case TEXEL0A: return s.texel0.a;
        case TEXEL1: return s.texel1.a;
        case ZERO: return 0;
        default: return s.input[c - INPUT_1].a;
    }
}

// (A - B) * C + D, with sm64ex's shortcuts for the common forms
static float3 combineColor(thread const Sources &s) {
    float3 a = colorOf(item(0, 0), s), b = colorOf(item(0, 1), s), c = colorOf(item(0, 2), s), d = colorOf(item(0, 3), s);
    if (item(0, 2) == ZERO) return d;
    if (item(0, 1) == ZERO && item(0, 3) == ZERO) return a * c;
    if (item(0, 1) == item(0, 3)) return mix(b, a, c);
    return (a - b) * c + d;
}

static float combineAlpha(thread const Sources &s) {
    float a = alphaOf(item(1, 0), s), b = alphaOf(item(1, 1), s), c = alphaOf(item(1, 2), s), d = alphaOf(item(1, 3), s);
    if (item(1, 2) == ZERO) return d;
    if (item(1, 1) == ZERO && item(1, 3) == ZERO) return a * c;
    if (item(1, 1) == item(1, 3)) return mix(b, a, c);
    return (a - b) * c + d;
}

static float random(float3 value) {
    float r = dot(sin(value), float3(12.9898, 78.233, 37.719));
    return fract(sin(r) * 143758.5453);
}

static float4 shade(Varyings in, texture2d<float> texture0, texture2d<float> texture1, sampler sampler0,
                    sampler sampler1, uint frame) {
    Sources s;
    s.texel0 = usesTexture(0) ? texture0.sample(sampler0, in.uv) : 0;
    s.texel1 = usesTexture(1) ? texture1.sample(sampler1, in.uv) : 0;
    s.input[0] = in.input1; s.input[1] = in.input2; s.input[2] = in.input3; s.input[3] = in.input4;

    float3 rgb = combineColor(s);
    float alpha = optAlpha ? combineAlpha(s) : 1.0;
    if (optAlpha && optTextureEdge) {
        if (alpha > 0.3) alpha = 1.0; else discard_fragment();
    }
    if (optFog) rgb = mix(rgb, in.fog.rgb, in.fog.a);
    if (optAlpha && optNoise) alpha *= floor(random(floor(float3(in.position.xy, float(frame)))) + 0.5);
    return float4(rgb, alpha);
}

fragment float4 game_fragment(Varyings in [[stage_in]],
                              texture2d<float> texture0 [[texture(0)]], texture2d<float> texture1 [[texture(1)]],
                              sampler sampler0 [[sampler(0)]], sampler sampler1 [[sampler(1)]],
                              constant uint &frame [[buffer(0)]]) {
    return shade(in, texture0, texture1, sampler0, sampler1, frame);
}

// How much of what's seen through the window's opening at the room point `room` shows over the room: it fades out
// to nothing towards the opening's edge (RoomEye.window.w), so the game has no hard border, the passthrough showing
// through around it. The same along each eye's line through a pixel, wherever on it: what's drawn over what keeps
// the same fade. From inside (your head through the window), no fade.
static float openingFade(float3 room, constant RoomEye &eye) {
    float width = eye.window.w;
    float3 p = (eye.windowFromRoom * float4(room, 1)).xyz, e = eye.eye.xyz;
    if (width <= 0 || e.z <= 0 || p.z >= e.z) return 1;
    float2 at = mix(e.xy, p.xy, e.z / (e.z - p.z));  // (where the line from the eye crosses the window's plane)
    float2 f = smoothstep(0.0, width, eye.window.xy - abs(at));
    return f.x * f.y;
}

// In the room the level is seen only through the window's opening: from outside, what's behind the window and seen
// through the opening; from inside (your head put through it), everything behind the window. Nothing of it comes out
// into the room: the game camera stands in front of the window, so the level reaches past it towards you, but what
// lies on your side of the window is cut off there, as if the window were the camera's near plane, and painted on
// the glass instead (window_picture_fragment). (Mario carried out into the room is drawn as an actor, not here.)
// The output is linear, as the layer's sRGB colour wants it.
fragment float4 game_fragment_room(Varyings in [[stage_in]],
                                   texture2d<float> texture0 [[texture(0)]], texture2d<float> texture1 [[texture(1)]],
                                   sampler sampler0 [[sampler(0)]], sampler sampler1 [[sampler(1)]],
                                   constant uint &frame [[buffer(0)]], constant RoomEye &eye [[buffer(1)]],
                                   constant RoomDraw &draw [[buffer(2)]]) {
    float fade = 1;
    if (draw.kind.x <= 1) {  // (the level and its sky; not flat pictures on the window, nor Mario in the room)
        fade = openingFade(in.room, eye);
        if (fade <= 0) discard_fragment();
        float3 p = (eye.windowFromRoom * float4(in.room, 1)).xyz, e = eye.eye.xyz;
        if (p.z > 0) discard_fragment();  // (on your side of the window)
        bool inside = e.z <= 0;
        if (!inside) {
            float2 at = mix(e.xy, p.xy, e.z / (e.z - p.z));
            if (any(abs(at) > eye.window.xy)) discard_fragment();
        }
    }
    if (draw.kind.x == 4 && in.room.y < as_type<float>(draw.kind.y)) discard_fragment();
    float4 color = shade(in, texture0, texture1, sampler0, sampler1, frame);
    if (depthOnly && color.a < 0.03) discard_fragment();  // (only where it shows)
    float3 c = saturate(color.rgb);
    float3 linear = select(pow((c + 0.055) / 1.055, 2.4), c / 12.92, c <= 0.04045);
    // (premultiplied, as the layer is: opaque, fading out to the room; blended, over what's there, faded already)
    return opaque ? float4(linear * fade, fade) : float4(linear, color.a * fade);
}

// The room's own surfaces (scene reconstruction), into depth only: the real furniture hides Mario behind it
vertex float4 room_mesh_vertex(uint vid [[vertex_id]], const device packed_float3 *positions [[buffer(0)]],
                               constant RoomEye &eye [[buffer(2)]]) {
    return eye.viewProjection * float4(float3(positions[vid]), 1);
}

// ---------------------------------------------------------------- Props: the cartridge, the window's frame, labels
struct PropVertex { packed_float3 position; packed_float3 normal; packed_float2 uv; };
struct PropDraw {
    float4x4 model;  // the prop's own space into the room (metres)
    float4 color;    // linear, multiplied by the texture
    uint4 flags;     // x: lit, y: only where seen through the window's opening, z: alpha tested, w: blended, but
                     // where it shows (not nearly transparent) it's in the depth buffer
    float4 uvTransform;  // the texture's coordinates: uv * xy + zw (repeating past 1: the title's backdrop)
};
struct PropVaryings { float4 position [[position]]; float3 normal; float2 uv; float3 room; };

// Whether the eye sees the room point `room` through the window's opening (both in the window's space)
static bool seenThroughOpening(float3 room, constant RoomEye &eye) {
    float3 p = (eye.windowFromRoom * float4(room, 1)).xyz, e = eye.eye.xyz;
    if ((e.z > 0) == (p.z > 0)) return false;
    float2 at = mix(e.xy, p.xy, e.z / (e.z - p.z));
    return all(abs(at) <= eye.window.xy);
}

vertex PropVaryings prop_vertex(uint vid [[vertex_id]], const device PropVertex *vertices [[buffer(0)]],
                                constant PropDraw &draw [[buffer(1)]], constant RoomEye &eye [[buffer(2)]]) {
    PropVertex v = vertices[vid];
    PropVaryings out;
    float4 room = draw.model * float4(float3(v.position), 1);
    out.position = eye.viewProjection * room;
    out.normal = (draw.model * float4(float3(v.normal), 0)).xyz;
    out.uv = float2(v.uv) * draw.uvTransform.xy + draw.uvTransform.zw;
    out.room = room.xyz;
    return out;
}

/// A tracking area's value (the system's hover effect lights up the one you look at), where a prop is drawn
fragment ushort tracking_area_fragment(PropVaryings in [[stage_in]], constant ushort &value [[buffer(3)]]) {
    return value;
}

fragment float4 prop_fragment(PropVaryings in [[stage_in]], constant PropDraw &draw [[buffer(1)]],
                              constant RoomEye &eye [[buffer(2)]],
                              texture2d<float> texture [[texture(0)]], sampler s [[sampler(0)]]) {
    if (draw.flags.y != 0 && !seenThroughOpening(in.room, eye)) discard_fragment();
    float fade = draw.flags.y != 0 ? openingFade(in.room, eye) : 1;
    float4 color = draw.color * texture.sample(s, in.uv);
    if (draw.flags.z != 0 && color.a < 0.5) discard_fragment();
    if (draw.flags.w != 0 && color.a < 0.03) discard_fragment();
    if (draw.flags.x != 0) {
        float light = 0.6 + 0.4 * saturate(dot(normalize(in.normal), normalize(float3(0.3, 1, 0.5))));
        color.rgb *= light;
    }
    if (draw.flags.z != 0) color.a = 1;
    // (premultiplied where it fades: the props seen through the opening are opaque, the title's backdrop)
    return fade < 1 ? float4(color.rgb * fade, color.a * fade) : color;
}

// What the level has between the game camera and the window, painted on the glass: the game's own flat picture
// (`picture`, its depth `depth`, as game_vertex drew them), only where its nearest surface is nearer the camera
// than the window, or only just past it (depth under `nearer`: it overlaps the level cut off at the window, so no
// gap shows between them). The level itself is cut off at the window (game_fragment_room), so from
// the camera's spot the window shows just what the flat game does. Not from inside: it's on your side of you then.
fragment float4 window_picture_fragment(PropVaryings in [[stage_in]], constant RoomEye &eye [[buffer(2)]],
                                        constant float &nearer [[buffer(3)]],
                                        texture2d<float> picture [[texture(0)]], depth2d<float> depth [[texture(1)]],
                                        sampler s [[sampler(0)]]) {
    if (eye.eye.z <= 0) discard_fragment();
    uint2 size = uint2(depth.get_width(), depth.get_height());
    uint2 pixel = min(uint2(in.uv * float2(size)), size - 1);
    if (depth.read(pixel) >= nearer) discard_fragment();
    float3 c = saturate(picture.sample(s, in.uv).rgb);
    float3 linear = select(pow((c + 0.055) / 1.055, 2.4), c / 12.92, c <= 0.04045);
    float fade = openingFade(in.room, eye);  // (as the level behind it fades: premultiplied)
    return float4(linear * fade, fade);
}

// ---------------------------------------------------------------- Mario's gloves over your hands
// Each hand's glove (GloveMesh: Apple's sample's glove, its shape only), skinned to the tracked hand: each vertex
// moved by up to four of the glove's 27 joints (their matrices from the bind pose into the room, metres). Drawn as
// solid things are, into depth.
struct GloveVertex { packed_float3 position; packed_float3 normal; uchar4 joints; uchar4 weights; };
struct GloveVaryings {
    float4 position [[position]];
    float3 room;
    float3 normal;
};

vertex GloveVaryings glove_vertex(uint vid [[vertex_id]], const device GloveVertex *vertices [[buffer(0)]],
                                  constant float4x4 *skin [[buffer(1)]], constant RoomEye &eye [[buffer(2)]]) {
    GloveVertex v = vertices[vid];
    float4 w = float4(v.weights) / 255.0;
    float4x4 m = skin[v.joints.x] * w.x + skin[v.joints.y] * w.y + skin[v.joints.z] * w.z + skin[v.joints.w] * w.w;
    float3 room = (m * float4(float3(v.position), 1)).xyz;
    GloveVaryings out;
    out.position = eye.viewProjection * float4(room, 1);
    out.room = room;
    out.normal = (m * float4(float3(v.normal), 0)).xyz;  // (the joints turn and scale evenly)
    return out;
}

// White cloth, softly lit from above and from where you look (what faces you is never in shadow, its edges turning
// a cool grey). Blended by what's already there (RoomProps.encodeGloves): only over the game, the passthrough left
// showing your own hand everywhere else
fragment float4 glove_fragment(GloveVaryings in [[stage_in]], constant RoomEye &eye [[buffer(2)]]) {
    float3 origin = (eye.roomFromWindow * float4(eye.eye.xyz, 1)).xyz;
    float3 ray = normalize(in.room - origin);
    float3 n = normalize(in.normal);
    if (dot(n, ray) > 0) n = -n;  // (inside the cuff, seen through its opening)
    float above = saturate(dot(n, normalize(float3(0.3, 1, 0.5))) * 0.5 + 0.5);
    float facing = saturate(dot(n, -ray));
    float light = saturate(0.45 * above * above + 0.6 * sqrt(facing));
    float3 color = mix(float3(0.40, 0.43, 0.52), float3(0.98), light);
    return float4(color * 0.92, 1);  // (linear)
}

// ---------------------------------------------------------------- The title screen's face (libgoddard)
struct GdVertex { packed_float3 position; packed_float2 uv; uchar4 color; };
struct TitleDraw {
    float4x4 roomFromGd;    // the batch's space (Goddard's eye space, or its 320×240 screen) into the room
    uchar4 colorCombine;    // (a - b) * c + d, GD_CC_* each
    uchar4 alphaCombine;
    float4 prim, env;
    uint4 flags;            // x: GD_BATCH_*, y: textured
};
struct TitleVaryings { float4 position [[position]]; float2 uv; float4 shade; float3 room; };

vertex TitleVaryings title_vertex(uint vid [[vertex_id]], const device GdVertex *vertices [[buffer(0)]],
                                  constant TitleDraw &draw [[buffer(1)]], constant RoomEye &eye [[buffer(2)]]) {
    GdVertex v = vertices[vid];
    TitleVaryings out;
    float4 room = draw.roomFromGd * float4(float3(v.position), 1);
    out.position = eye.viewProjection * room;
    out.uv = float2(v.uv);
    out.shade = float4(v.color) / 255.0;
    out.room = room.xyz;
    return out;
}

static float4 gdInput(uint which, float4 texel, float4 shade, constant TitleDraw &d) {
    switch (which) {
        case 0: return float4(0);
        case 1: return float4(1);
        case 2: return texel;
        case 3: return float4(texel.a);
        case 4: return d.prim;
        case 5: return float4(d.prim.a);
        case 6: return shade;
        case 7: return float4(shade.a);
        case 8: return d.env;
        default: return float4(d.env.a);
    }
}

// The face is seen through the window's opening, but what's pulled out of it (his nose) is out in the room
fragment float4 title_fragment(TitleVaryings in [[stage_in]], constant TitleDraw &d [[buffer(1)]],
                               constant RoomEye &eye [[buffer(2)]],
                               texture2d<float> texture [[texture(0)]], sampler s [[sampler(0)]]) {
    bool through = (d.flags.x & 1) == 0 && (eye.windowFromRoom * float4(in.room, 1)).z < 0;
    if (through && !seenThroughOpening(in.room, eye)) discard_fragment();
    float fade = through ? openingFade(in.room, eye) : 1;
    float4 texel = d.flags.y != 0 ? texture.sample(s, in.uv) : float4(1);
    uchar4 c = d.colorCombine, a = d.alphaCombine;
    float3 rgb = (gdInput(c.x, texel, in.shade, d).rgb - gdInput(c.y, texel, in.shade, d).rgb)
                 * gdInput(c.z, texel, in.shade, d).rgb + gdInput(c.w, texel, in.shade, d).rgb;
    float alpha = (gdInput(a.x, texel, in.shade, d).a - gdInput(a.y, texel, in.shade, d).a)
                  * gdInput(a.z, texel, in.shade, d).a + gdInput(a.w, texel, in.shade, d).a;
    uint flags = d.flags.x;
    if ((flags & 4) != 0 && alpha < 0.5) discard_fragment();      // GD_BATCH_CUTOUT
    if ((flags & 2) == 0) alpha = 1;                               // (not blended: covers the passthrough)
    rgb = saturate(rgb);
    rgb = select(pow((rgb + 0.055) / 1.055, 2.4), rgb / 12.92, rgb <= 0.04045);  // (the layer is sRGB)
    alpha = saturate(alpha);
    // (premultiplied where it fades out: not blended; blended, its alpha only)
    return (flags & 2) == 0 ? float4(rgb * fade, fade) : float4(rgb, alpha * fade);
}
